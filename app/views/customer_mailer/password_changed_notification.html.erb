<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Changed Successfully</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f9fd;
      color: #333333;
      line-height: 1.6;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    .header {
      background: linear-gradient(135deg, #16a34a 0%, #0e3a5c 100%);
      padding: 40px 30px;
      text-align: center;
      color: white;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 600;
    }
    .content {
      padding: 40px 30px;
    }
    .greeting {
      font-size: 18px;
      margin-bottom: 20px;
      color: #1f2937;
    }
    .message {
      font-size: 16px;
      margin-bottom: 20px;
      line-height: 1.7;
    }
    .security-note {
      background-color: #fff3cd;
      border: 1px solid #ffeaa7;
      padding: 15px;
      border-radius: 6px;
      margin: 20px 0;
    }
    .security-note strong {
      color: #856404;
    }
    .footer {
      background-color: #f4f9fd;
      padding: 30px;
      text-align: center;
      color: #666;
      font-size: 14px;
    }
    @media only screen and (max-width: 600px) {
      .container {
        margin: 10px;
        border-radius: 5px;
      }
      .header, .content {
        padding: 30px 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>✅ Password Changed</h1>
    </div>

    <div class="content">
      <div class="greeting">
        Hello <%= @customer.first_name || @customer.email %>,
      </div>

      <div class="message">
        This is a confirmation that the password for your <%= @app_name %> account was just changed successfully.
      </div>

      <div class="security-note">
        <strong>Security reminder:</strong> If you did not make this change, please contact our support team immediately.
      </div>
    </div>

    <div class="footer">
      <p>
        <strong>AtmaNirbhar Farm</strong><br>
        Fresh. Organic. Delivered.<br>
        <a href="mailto:support@atmanirbharfarm.com">support@atmanirbharfarm.com</a>
      </p>
      <p style="margin-top: 20px; font-size: 12px; color: #999;">
        This email was sent to <%= @customer.email %>.
      </p>
    </div>
  </div>
</body>
</html>
