<%= form_with model: [:admin, @category], local: true, multipart: true, class: "row g-4" do |form| %>
  <% if @category.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger border-0 shadow-sm">
        <div class="d-flex align-items-center">
          <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
          <div>
            <h6 class="alert-heading mb-1">Please fix the following errors:</h6>
            <ul class="mb-0 small">
              <% @category.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Basic Details Section -->
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-0 pb-0">
        <div class="d-flex align-items-center">
          <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
            <i class="bi bi-info-circle text-primary"></i>
          </div>
          <h5 class="card-title mb-0">Basic Details</h5>
        </div>
      </div>
      <div class="card-body pt-3">
        <div class="row g-3">
          <div class="col-md-6">
            <%= form.label :name, class: "form-label fw-medium" %>
            <span class="text-danger ms-1">*</span>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="bi bi-tag text-muted"></i>
              </span>
              <%= form.text_field :name, class: "form-control border-start-0 ps-0", placeholder: "Enter category name", required: true %>
            </div>
          </div>

          <div class="col-12">
            <%= form.label :description, class: "form-label fw-medium" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 align-items-start pt-2">
                <i class="bi bi-text-left text-muted"></i>
              </span>
              <%= form.text_area :description, class: "form-control border-start-0 ps-0", rows: 4, placeholder: "Enter category description" %>
            </div>
          </div>

          <div class="col-md-6">
            <%= form.label :display_order, class: "form-label fw-medium" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="bi bi-sort-numeric-up text-muted"></i>
              </span>
              <%= form.number_field :display_order, class: "form-control border-start-0 ps-0", min: 0, value: @category.display_order || 0 %>
            </div>
            <div class="form-text">
              <i class="bi bi-info-circle me-1"></i>
              Lower numbers appear first
            </div>
          </div>

          <div class="col-md-6">
            <%= form.label :status, "Status", class: "form-label fw-medium" %>
            <div class="mt-2">
              <div class="form-check form-switch">
                <%= form.check_box :status, { class: "form-check-input", checked: @category.status != false }, "true", "false" %>
                <%= form.label :status, class: "form-check-label fw-medium" do %>
                  <i class="bi bi-check-circle text-success me-1"></i>
                  Active
                <% end %>
              </div>
              <div class="form-text">Toggle to activate/deactivate this category</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Image Upload Section -->
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-0 pb-0">
        <div class="d-flex align-items-center">
          <div class="bg-success bg-opacity-10 rounded p-2 me-3">
            <i class="bi bi-image text-success"></i>
          </div>
          <h5 class="card-title mb-0">Category Image</h5>
        </div>
      </div>
      <div class="card-body pt-3">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-medium">Upload Image</label>
            <input type="file" id="category-image-input" class="d-none" accept="image/*">
            <div>
              <button type="button" class="btn btn-primary" id="category-image-btn"
                      onclick="document.getElementById('category-image-input').click()">
                <i class="bi bi-cloud-arrow-up me-1"></i> Choose Image
              </button>
            </div>
            <div class="form-text">
              <i class="bi bi-info-circle me-1"></i>
              Uploaded to Cloudinary (JPG, PNG, GIF, WebP). First choose an image, then save the category.
            </div>

            <%# Cloudinary public_id is stored here and persisted with the category %>
            <%= form.hidden_field :image_url, id: "category-image-url" %>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-medium">
              <span id="preview-label"><%= @category.has_image? ? 'Current Image' : 'Image Preview' %></span>
            </label>
            <div class="image-preview-container p-3 border border-2 border-dashed rounded bg-light text-center" id="image-preview-container">
              <div id="no-preview" class="text-muted <%= 'd-none' if @category.has_image? %>">
                <i class="bi bi-image fs-1 d-block mb-2"></i>
                <small>No image selected</small>
              </div>
              <%= tag.img id: "image-preview",
                    class: "img-thumbnail shadow-sm #{'d-none' unless @category.has_image?}",
                    style: "max-width: 150px; max-height: 150px;",
                    src: (@category.display_image_url if @category.has_image?),
                    alt: "Image preview" %>
              <div id="upload-status" class="small mt-2"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-end gap-2">
          <%= link_to admin_categories_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-x-lg me-1"></i> Cancel
          <% end %>

          <button type="submit" class="btn btn-primary">
            <i class="bi bi-<%= @category.new_record? ? 'plus-circle' : 'check-circle' %> me-1"></i>
            <%= @category.new_record? ? 'Create Category' : 'Update Category' %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
// Category image upload via Cloudinary - mirrors the product form's Cloudinary flow.
document.addEventListener('DOMContentLoaded', function() {
  const imageInput   = document.getElementById('category-image-input');
  const imagePreview = document.getElementById('image-preview');
  const noPreview    = document.getElementById('no-preview');
  const previewLabel = document.getElementById('preview-label');
  const imageUrlField = document.getElementById('category-image-url');
  const uploadBtn    = document.getElementById('category-image-btn');
  const uploadStatus = document.getElementById('upload-status');
  const form         = imageInput ? imageInput.closest('form') : null;
  const csrfToken    = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

  let isUploading = false;

  if (!imageInput) return;

  imageInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file || !file.type.startsWith('image/')) return;

    // Instant local preview while the upload runs
    const reader = new FileReader();
    reader.onload = function(ev) {
      imagePreview.src = ev.target.result;
      imagePreview.classList.remove('d-none');
      if (noPreview) noPreview.classList.add('d-none');
      previewLabel.textContent = 'Image Preview';
    };
    reader.readAsDataURL(file);

    uploadToCloudinary(file);
  });

  function uploadToCloudinary(file) {
    isUploading = true;
    const originalBtn = uploadBtn.innerHTML;
    uploadBtn.disabled = true;
    uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading...';
    uploadStatus.textContent = '';
    uploadStatus.className = 'small mt-2 text-muted';

    const formData = new FormData();
    formData.append('image', file);

    fetch('<%= upload_cloudinary_image_admin_categories_path %>', {
      method: 'POST',
      body: formData,
      headers: { 'X-CSRF-Token': csrfToken }
    })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          imageUrlField.value = data.public_id;
          imagePreview.src = data.thumbnail_url || data.url;
          uploadStatus.textContent = '✓ Uploaded';
          uploadStatus.className = 'small mt-2 text-success';
        } else {
          throw new Error(data.error || 'Upload failed');
        }
      })
      .catch(function(err) {
        uploadStatus.textContent = '✗ ' + err.message;
        uploadStatus.className = 'small mt-2 text-danger';
        imageUrlField.value = '';
      })
      .finally(function() {
        isUploading = false;
        uploadBtn.disabled = false;
        uploadBtn.innerHTML = originalBtn;
      });
  }

  // Don't let the category save mid-upload (would persist a blank image_url)
  if (form) {
    form.addEventListener('submit', function(e) {
      if (isUploading) {
        e.preventDefault();
        alert('Please wait for the image upload to finish.');
      }
    });
  }
});
</script>