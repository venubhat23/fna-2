<% content_for :title, "Edit Delivery Charge - #{@delivery_charge.pincode}" %>

<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

      <div class="d-flex align-items-center mb-4 gap-3">
        <%= link_to admin_delivery_settings_path, class: "btn btn-outline-secondary btn-sm" do %>
          <i class="fas fa-arrow-left me-1"></i> Back to Delivery Settings
        <% end %>
        <h4 class="mb-0"><i class="fas fa-truck me-2"></i>Edit Delivery Charge</h4>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Pincode: <strong><%= @delivery_charge.pincode %></strong></h5>
        </div>
        <div class="card-body p-4">

          <% if flash[:alert] %>
            <div class="alert alert-danger"><%= flash[:alert] %></div>
          <% end %>

          <%= form_with url: admin_delivery_setting_path(@delivery_charge), scope: :delivery_charge, method: :patch, local: true do |f| %>

            <div class="mb-3">
              <label class="form-label fw-semibold">Pincode</label>
              <input type="text" class="form-control bg-light" value="<%= @delivery_charge.pincode %>" readonly>
              <div class="form-text">Pincode cannot be changed after creation.</div>
            </div>

            <div class="mb-3">
              <label for="delivery_charge_area" class="form-label fw-semibold">Area</label>
              <%= f.text_field :area, class: "form-control", placeholder: "e.g., MG Road", id: "delivery_charge_area" %>
            </div>

            <div class="mb-3">
              <label for="delivery_charge_charge_amount" class="form-label fw-semibold">
                Charge Amount (₹) <span class="text-danger">*</span>
              </label>
              <%= f.number_field :charge_amount, class: "form-control", min: 0, step: 0.01, required: true, id: "delivery_charge_charge_amount" %>
            </div>

            <div class="mb-3">
              <div class="form-check form-switch">
                <%= f.check_box :free_delivery_allowed, class: "form-check-input", role: "switch",
                      id: "delivery_charge_free_delivery_allowed",
                      onchange: "toggleMinOrderField(this)" %>
                <label class="form-check-label fw-semibold" for="delivery_charge_free_delivery_allowed">
                  Free Delivery Allowed?
                </label>
                <div class="form-text">Enable to offer free delivery when order meets minimum amount.</div>
              </div>
            </div>

            <div class="mb-4" id="min-order-field" style="display:<%= @delivery_charge.free_delivery_allowed? ? 'block' : 'none' %>;">
              <label for="delivery_charge_min_order_for_free_delivery" class="form-label fw-semibold">
                Minimum Order Amount for Free Delivery (₹)
              </label>
              <%= f.number_field :min_order_for_free_delivery, class: "form-control", min: 0, step: 1,
                    placeholder: "e.g., 500", id: "delivery_charge_min_order_for_free_delivery" %>
              <div class="form-text">Orders at or above this amount get free delivery for this pincode.</div>
            </div>

            <div class="mb-3">
              <div class="form-check form-switch">
                <%= f.check_box :is_active, class: "form-check-input", role: "switch",
                      id: "delivery_charge_is_active" %>
                <label class="form-check-label fw-semibold" for="delivery_charge_is_active">Active</label>
              </div>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Update Delivery Charge", class: "btn btn-primary px-4" %>
              <%= link_to "Cancel", admin_delivery_settings_path, class: "btn btn-outline-secondary" %>
            </div>

          <% end %>

          <script>
            function toggleMinOrderField(checkbox) {
              document.getElementById('min-order-field').style.display = checkbox.checked ? 'block' : 'none';
            }
          </script>

        </div>
      </div>

    </div>
  </div>
</div>
