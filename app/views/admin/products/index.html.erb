<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Product Management</h2>
    <p class="text-muted mb-0">Manage your product inventory and catalog</p>
  </div>
  <div>
    <%= link_to new_admin_product_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Product
    <% end %>
  </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">Total Products</h6>
            <h4 class="mb-0"><%= @products.respond_to?(:total_count) ? @products.total_count : @products.count %></h4>
          </div>
          <div class="text-primary">
            <i class="bi bi-box-seam fs-2"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">Active Products</h6>
            <h4 class="mb-0"><%= @product_stats[:active] %></h4>
          </div>
          <div class="text-success">
            <i class="bi bi-check-circle fs-2"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">In Stock</h6>
            <h4 class="mb-0"><%= @product_stats[:in_stock] %></h4>
          </div>
          <div class="text-info">
            <i class="bi bi-box fs-2"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="text-muted mb-1">Low Stock</h6>
            <h4 class="mb-0"><%= @product_stats[:low_stock] %></h4>
          </div>
          <div class="text-warning">
            <i class="bi bi-exclamation-triangle fs-2"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h5 class="mb-0">Product Catalog</h5>
      <div class="d-flex flex-wrap gap-2">
        <div class="product-category-box">
          <%= select_tag :category_id,
                options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
                id: "categoryFilter", include_blank: true %>
        </div>
        <div class="product-search-box">
          <select id="productSearch" data-search-url="<%= search_admin_products_path %>" data-index-url="<%= admin_products_path %>">
            <% if @selected_product %>
              <option value="<%= @selected_product.id %>" selected><%= @selected_product.name %></option>
            <% end %>
          </select>
        </div>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <% if @products.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="border-0 fw-semibold">Product</th>
              <th class="border-0 fw-semibold">Category</th>
              <th class="border-0 fw-semibold">Price & Profit</th>
              <th class="border-0 fw-semibold">Stock</th>
              <th class="border-0 fw-semibold">Status</th>
              <th class="border-0 fw-semibold">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @products.each do |product| %>
              <tr>
                <td class="align-middle">
                  <div class="d-flex align-items-center">
                    <div class="position-relative me-3">
                      <% if product.main_image_url.present? %>
                        <img src="<%= product.main_image_url(width: 60, height: 60) %>"
                             alt="<%= product.name %>"
                             class="rounded-circle object-fit-cover"
                             style="width: 40px; height: 40px;">
                      <% elsif product.image.attached? %>
                        <%= image_tag product.image,
                            alt: product.name,
                            class: "rounded-circle object-fit-cover",
                            style: "width: 40px; height: 40px;" %>
                      <% else %>
                        <div class="avatar-sm bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                          <i class="bi bi-box-seam text-primary"></i>
                        </div>
                      <% end %>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= product.name %></h6>
                      <small class="text-muted">SKU: <%= product.sku || 'N/A' %></small>
                      <% if product.has_multiple_quantities? && product.product_variants.any? %>
                        <small class="d-block">
                          <span class="badge bg-primary-subtle text-primary">
                            <i class="bi bi-boxes me-1"></i><%= product.product_variants.size %> Variant<%= product.product_variants.size == 1 ? '' : 's' %>
                          </span>
                        </small>
                      <% else %>
                        <small class="d-block text-muted">No Variants</small>
                      <% end %>
                      <% if product.image_url.present? %>
                        <small class="text-success d-block">
                          <i class="bi bi-cloud-check me-1"></i>Cloudinary
                        </small>
                      <% elsif product.image.attached? %>
                        <small class="text-info d-block">
                          <i class="bi bi-server me-1"></i>Local
                        </small>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="align-middle">
                  <span class="badge bg-secondary-subtle text-secondary"><%= product.category&.name || 'No Category' %></span>
                </td>
                <td class="align-middle">
                  <div>
                    <!-- Selling Price -->
                    <div class="d-flex align-items-center gap-2">
                      <span class="fw-medium">
                        <%= product.respond_to?(:formatted_selling_price) ? product.formatted_selling_price : number_to_currency(product.final_price_after_discount) %>
                      </span>
                      <% if product.discounted? %>
                        <small class="badge bg-success-subtle text-success">
                          <%= product.discount_percentage.round(1) %>% OFF
                        </small>
                      <% end %>
                    </div>

                    <!-- Discount Info -->
                    <% if product.discounted? %>
                      <small class="text-muted text-decoration-line-through">
                        MRP: <%= number_to_currency(product.original_price || product.price) %>
                      </small>
                      <br>
                    <% end %>

                    <!-- Profit Info -->
                    <% if product.buying_price.present? %>
                      <div class="small mt-1">
                        <span class="text-muted">Cost: ₹<%= product.buying_price.round(2) %></span>
                        <span class="mx-1">•</span>
                        <span class="<%= product.profit_status_class %> fw-medium">
                          Profit: ₹<%= product.profit_amount.round(2) %>
                        </span>
                        <% if product.profit_percentage != 0 %>
                          <span class="mx-1">•</span>
                          <span class="<%= product.profit_status_class %> fw-medium">
                            <%= product.profit_margin_percentage.round(1) %>%
                          </span>
                        <% end %>
                      </div>
                      <div class="small">
                        <span class="badge bg-<%= product.profitable? ? 'success' : (product.profit_amount == 0 ? 'warning' : 'danger') %>-subtle text-<%= product.profitable? ? 'success' : (product.profit_amount == 0 ? 'warning' : 'danger') %>">
                          <%= product.profit_status %>
                        </span>
                      </div>
                    <% else %>
                      <small class="text-muted">No cost price set</small>
                    <% end %>
                  </div>
                </td>
                <td class="align-middle">
                  <% if product.has_multiple_quantities? %>
                    <% product.sorted_variants.each do |variant| %>
                      <div class="d-flex justify-content-between align-items-center" style="min-width: 140px;">
                        <span class="small text-muted me-2"><%= variant.label %></span>
                        <% if variant.available_stock.to_i > 0 %>
                          <span class="text-success fw-medium small"><%= variant.available_stock.to_i %></span>
                        <% else %>
                          <span class="text-danger fw-medium small">0</span>
                        <% end %>
                      </div>
                    <% end %>
                  <% elsif product.stock.to_i > 0 %>
                    <span class="text-success fw-medium"><%= product.stock %> <%= product.unit_type %></span>
                    <div class="small text-muted">In Stock</div>
                  <% else %>
                    <span class="text-danger fw-medium">0 <%= product.unit_type %></span>
                    <div class="small text-muted">Out of Stock</div>
                  <% end %>
                </td>
                <td class="align-middle">
                  <% case product.status %>
                  <% when 'active' %>
                    <span class="badge bg-success-subtle text-success">
                      <i class="bi bi-check-circle me-1"></i>
                      Active
                    </span>
                  <% when 'inactive' %>
                    <span class="badge bg-danger-subtle text-danger">
                      <i class="bi bi-x-circle me-1"></i>
                      Inactive
                    </span>
                  <% when 'draft' %>
                    <span class="badge bg-warning-subtle text-warning">
                      <i class="bi bi-clock me-1"></i>
                      Draft
                    </span>
                  <% else %>
                    <span class="badge bg-secondary-subtle text-secondary"><%= product.status&.humanize || 'Unknown' %></span>
                  <% end %>
                </td>
                <td class="align-middle">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      <i class="bi bi-three-dots"></i>
                    </button>
                    <ul class="dropdown-menu">
                      <li>
                        <%= link_to admin_product_path(product), class: "dropdown-item" do %>
                          <i class="bi bi-eye me-2"></i>
                          View Details
                        <% end %>
                      </li>
                      <li>
                        <%= link_to edit_admin_product_path(product), class: "dropdown-item" do %>
                          <i class="bi bi-pencil me-2"></i>
                          Edit Product
                        <% end %>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <%= link_to admin_product_path(product), method: :delete,
                            class: "dropdown-item text-danger",
                            confirm: "Are you sure you want to delete this product?",
                            data: {
                              confirm: "Are you sure you want to delete #{product.name}? This action cannot be undone."
                            } do %>
                          <i class="bi bi-trash me-2"></i>
                          Delete Product
                        <% end %>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if respond_to?(:paginate) && @products.respond_to?(:total_pages) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @products %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="bi bi-box-seam fs-1 text-muted"></i>
        </div>
        <h5 class="text-muted mb-3">No Products Found</h5>
        <p class="text-muted mb-4">Start by adding your first product to build your catalog and manage inventory.</p>
        <%= link_to "Add Product", new_admin_product_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .product-search-box { width: 380px; max-width: 100%; }
  .product-category-box { width: 240px; max-width: 100%; }
  .product-search-result { display: flex; align-items: center; gap: 12px; }
  .product-search-thumb {
    width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; object-fit: cover;
    display: flex; align-items: center; justify-content: center;
    background: rgba(13, 110, 253, 0.1); color: #0d6efd;
  }
  .product-search-info { flex-grow: 1; min-width: 0; }
  .product-search-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .product-search-meta { font-size: 0.8rem; opacity: 0.75; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .product-search-side { text-align: right; flex-shrink: 0; }
  .product-search-price { font-weight: 600; }
  .product-search-status { font-size: 0.7rem; text-transform: capitalize; opacity: 0.75; }
</style>

<script>
(function() {
  if (typeof $ === 'undefined' || !$.fn.select2) return;

  const select = $('#productSearch');
  const categorySelect = $('#categoryFilter');

  // Built with .text()/.attr() rather than an HTML string so product names can't inject markup.
  function renderProduct(product) {
    if (product.loading || !product.id) return product.text;

    const thumb = product.image_url
      ? $('<img class="product-search-thumb" alt="">').attr('src', product.image_url)
      : $('<div class="product-search-thumb"><i class="bi bi-box-seam"></i></div>');
    const meta = ['SKU: ' + (product.sku || 'N/A'), product.category].filter(Boolean).join(' • ');

    return $('<div class="product-search-result">').append(
      thumb,
      $('<div class="product-search-info">').append(
        $('<div class="product-search-name">').text(product.text),
        $('<div class="product-search-meta">').text(meta)
      ),
      $('<div class="product-search-side">').append(
        $('<div class="product-search-price">').text(product.price),
        $('<div class="product-search-status">').text(product.status || '')
      )
    );
  }

  function visit(filters) {
    const query = new URLSearchParams();
    Object.entries(filters).forEach(([key, value]) => { if (value) query.set(key, value); });

    const queryString = query.toString();
    const url = select.data('index-url') + (queryString ? '?' + queryString : '');

    if (window.Turbo) {
      Turbo.visit(url);
    } else {
      window.location.href = url;
    }
  }

  categorySelect.select2({
    theme: 'bootstrap-5',
    width: '100%',
    placeholder: 'All categories',
    allowClear: true,
    language: { noResults: function() { return 'No categories found'; } }
  });

  select.select2({
    theme: 'bootstrap-5',
    width: '100%',
    placeholder: 'Search products by name or SKU...',
    allowClear: true,
    minimumInputLength: 1,
    templateResult: renderProduct,
    language: {
      inputTooShort: function() { return 'Start typing a product name or SKU'; },
      noResults: function() { return 'No products found'; },
      searching: function() { return 'Searching...'; }
    },
    ajax: {
      url: select.data('search-url'),
      dataType: 'json',
      delay: 250,
      data: function(params) { return { q: params.term, category_id: categorySelect.val() }; },
      processResults: function(data) { return { results: data }; }
    }
  });

  $('#productSearch, #categoryFilter').on('select2:open', function() {
    document.querySelector('.select2-container--open .select2-search__field')?.focus();
  });

  select.on('select2:select', function(event) {
    visit({ category_id: categorySelect.val(), product_id: event.params.data.id });
  });

  select.on('select2:clear', function() {
    visit({ category_id: categorySelect.val() });
  });

  // A selected product may not be in the new category, so changing category drops it.
  categorySelect.on('select2:select', function(event) {
    visit({ category_id: event.params.data.id });
  });

  categorySelect.on('select2:clear', function() {
    visit({});
  });

  // Turbo snapshots the page when leaving it; put the plain <select> back so going
  // back doesn't restore a dead Select2 box next to a freshly initialised one.
  document.addEventListener('turbo:before-cache', function() {
    [select, categorySelect].forEach(function(element) {
      if (element.hasClass('select2-hidden-accessible')) element.select2('destroy');
    });
  }, { once: true });
})();
</script>

