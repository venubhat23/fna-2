<% content_for :title, 'Checkout' %>

<div class="container py-4">
  <h1 class="mb-4">
    <i class="bi bi-credit-card me-2"></i>Checkout
  </h1>

  <!-- Checkout Steps -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-center">
        <div class="d-flex align-items-center">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-cart-check"></i>
          </div>
          <div class="bg-primary" style="width: 50px; height: 2px;"></div>
          <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-geo-alt"></i>
          </div>
          <div class="bg-secondary" style="width: 50px; height: 2px;"></div>
          <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-credit-card"></i>
          </div>
        </div>
      </div>
      <div class="d-flex justify-content-center mt-2">
        <div class="d-flex" style="width: 300px;">
          <small class="text-primary fw-semibold" style="width: 100px;">Cart Review</small>
          <small class="text-muted" style="width: 100px; text-align: center;">Address</small>
          <small class="text-muted" style="width: 100px; text-align: right;">Payment</small>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Order Summary -->
    <div class="col-lg-8">
      <div class="bg-white rounded shadow-sm p-4 mb-4">
        <h4 class="mb-4">Order Summary</h4>

        <% @cart_items.each do |item| %>
          <div class="row align-items-center py-3 border-bottom">
            <div class="col-md-2">
              <% if item['image_url'].present? %>
                <%= image_tag item['image_url'], class: "img-fluid rounded", style: "height: 60px; object-fit: cover;" %>
              <% else %>
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 60px;">
                  <i class="bi bi-image text-muted"></i>
                </div>
              <% end %>
            </div>
            <div class="col-md-6">
              <h6 class="fw-semibold mb-1"><%= item['product_name'] %></h6>
              <p class="text-muted small mb-0">Quantity: <%= item['quantity'] %></p>
            </div>
            <div class="col-md-2">
              <p class="fw-semibold mb-0">₹<%= item['price'] %></p>
            </div>
            <div class="col-md-2 text-end">
              <p class="fw-bold mb-0">₹<%= (item['price'].to_f * item['quantity'].to_i).round(2) %></p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Delivery Address -->
      <div class="bg-white rounded shadow-sm p-4">
        <h4 class="mb-4">Delivery Address</h4>

        <% if @addresses.any? %>
          <div class="row">
            <% @addresses.each do |address| %>
              <div class="col-md-6 mb-3">
                <div class="border rounded p-3">
                  <div class="form-check">
                    <input class="form-check-input address-radio" type="radio" name="selected_address_id" value="<%= address.id %>" id="address_<%= address.id %>" data-pincode="<%= address.pincode %>" <%= 'checked' if @selected_address&.id == address.id %>>
                    <label class="form-check-label w-100" for="address_<%= address.id %>">
                      <strong><%= address.name %></strong>
                      <span class="badge bg-secondary ms-2"><%= address.address_type.humanize %></span>
                      <br>
                      <small class="text-muted">
                        <%= address.address %><br>
                        <% if address.landmark.present? %>
                          <%= address.landmark %><br>
                        <% end %>
                        <%= address.city %>, <%= address.state %> - <%= address.pincode %><br>
                        <i class="bi bi-phone"></i> <%= address.mobile %>
                      </small>
                    </label>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="text-center mt-3">
            <%= link_to address_customer_checkout_index_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-plus me-1"></i>Add New Address
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-4">
            <i class="bi bi-geo-alt display-4 text-muted mb-3"></i>
            <h5>No delivery address found</h5>
            <p class="text-muted">Please add a delivery address to continue</p>
            <%= link_to address_customer_checkout_index_path, class: "btn btn-primary" do %>
              <i class="bi bi-plus me-2"></i>Add Delivery Address
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="col-lg-4">
      <div class="checkout-sidebar">
        <div class="bg-white rounded shadow-sm p-4">
          <h5 class="mb-4">Order Total</h5>

          <div class="d-flex justify-content-between mb-2">
            <span>Subtotal</span>
            <span>₹<%= @cart_total %></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Shipping</span>
            <span id="sidebar-delivery-charge">
              <% if !@delivery_info[:serviceable] %>
                <span class="text-muted">—</span>
              <% elsif @delivery_info[:charge].to_f > 0 %>
                ₹<%= number_with_precision(@delivery_info[:charge], precision: 2) %>
              <% else %>
                <span class="text-success">Free</span>
              <% end %>
            </span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Tax</span>
            <span>₹0</span>
          </div>

          <hr>

          <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
            <span>Total</span>
            <span class="text-success" id="sidebar-total">₹<%= number_with_precision(@cart_total + @delivery_info[:charge].to_f, precision: 2) %></span>
          </div>

          <!-- Attractive free-delivery progress banner -->
          <div id="free-delivery-banner" class="mb-3">
            <% if !@delivery_info[:serviceable] %>
              <div class="free-delivery-card unserviceable-state">
                <div class="fdc-title"><i class="bi bi-info-circle me-1"></i>Select an address to see delivery charges</div>
                <div class="fdc-sub mb-0">We'll show delivery charges and free-delivery eligibility once a pincode is selected.</div>
              </div>
            <% elsif @delivery_info[:free_delivery_allowed] && @delivery_info[:free_unlocked] %>
              <div class="free-delivery-card unlocked-state">
                <div class="fdc-title"><i class="bi bi-emoji-smile-fill me-1"></i>Free Delivery Unlocked 🎉</div>
                <div class="fdc-sub mb-0">No delivery charges on this order.</div>
              </div>
            <% elsif @delivery_info[:free_delivery_allowed] %>
              <% pct = @delivery_info[:threshold].to_f > 0 ? [(@cart_total / @delivery_info[:threshold].to_f * 100).round, 100].min : 0 %>
              <div class="free-delivery-card progress-state">
                <div class="fdc-title"><i class="bi bi-truck me-1"></i>₹<%= number_with_precision(@delivery_info[:remaining], precision: 0) %> away from FREE Delivery!</div>
                <div class="fdc-sub mb-0">Add more items to unlock free delivery (min. order ₹<%= number_with_precision(@delivery_info[:threshold], precision: 0) %>).</div>
                <div class="fdc-progress-track">
                  <div class="fdc-progress-fill" style="width:<%= pct %>%"></div>
                </div>
              </div>
            <% else %>
              <div class="free-delivery-card flat-state">
                <div class="fdc-title"><i class="bi bi-truck me-1"></i>Delivery Charge: ₹<%= number_with_precision(@delivery_info[:charge], precision: 2) %></div>
                <div class="fdc-sub mb-0">A flat delivery charge applies to this area.</div>
              </div>
            <% end %>
          </div>

          <% if @addresses.any? %>
            <div class="d-grid">
              <button type="button" id="continue-to-payment-btn" class="btn btn-primary btn-lg">
                Continue to Payment
                <i class="bi bi-arrow-right ms-2"></i>
              </button>
            </div>
          <% end %>

          <div class="text-center mt-3">
            <%= link_to customer_cart_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-left me-1"></i>Back to Cart
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.free-delivery-card {
  border-radius: 14px;
  padding: 16px 18px;
  color: #fff;
}
.free-delivery-card.progress-state {
  background: linear-gradient(135deg, #ff8a3d 0%, #ff5f6d 100%);
  box-shadow: 0 6px 18px rgba(255, 95, 109, 0.28);
}
.free-delivery-card.unlocked-state {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  box-shadow: 0 6px 18px rgba(34, 197, 94, 0.3);
}
.free-delivery-card.flat-state {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  box-shadow: 0 6px 18px rgba(79, 70, 229, 0.25);
}
.free-delivery-card.unserviceable-state {
  background: #fff3cd;
  color: #664d03;
  border: 1px solid #ffe69c;
}
.free-delivery-card .fdc-title { font-weight: 700; font-size: 1rem; margin-bottom: 4px; }
.free-delivery-card .fdc-sub { font-size: 0.82rem; opacity: 0.92; margin-bottom: 10px; }
.free-delivery-card .fdc-progress-track { background: rgba(255,255,255,0.35); border-radius: 999px; height: 8px; overflow: hidden; }
.free-delivery-card .fdc-progress-fill { background: #fff; height: 100%; border-radius: 999px; transition: width 0.4s ease; }
</style>

<script>
const cartTotal = <%= @cart_total.to_f %>;

function setSelectedAddress() {
  const selectedAddress = document.querySelector('input[name="selected_address_id"]:checked');
  if (selectedAddress) {
    sessionStorage.setItem('selected_address_id', selectedAddress.value);
  }
}

// The selected address has to reach the server (query param), not just
// browser sessionStorage, since #payment/#create read it from params/session.
const continueToPaymentBtn = document.getElementById('continue-to-payment-btn');
if (continueToPaymentBtn) {
  continueToPaymentBtn.addEventListener('click', function() {
    const selectedAddress = document.querySelector('input[name="selected_address_id"]:checked');
    if (!selectedAddress) {
      alert('Please select a delivery address.');
      return;
    }
    setSelectedAddress();
    window.location.href = `<%= payment_customer_checkout_index_path %>?selected_address_id=${selectedAddress.value}`;
  });
}

function renderDeliveryBanner(info) {
  const chargeEl = document.getElementById('sidebar-delivery-charge');
  const totalEl = document.getElementById('sidebar-total');
  const banner = document.getElementById('free-delivery-banner');
  const charge = Number(info.charge || 0);
  const total = cartTotal + (info.serviceable ? charge : 0);

  totalEl.textContent = `₹${total.toFixed(2)}`;

  if (!info.serviceable) {
    chargeEl.innerHTML = '<span class="text-muted">—</span>';
    banner.innerHTML = `
      <div class="free-delivery-card unserviceable-state">
        <div class="fdc-title"><i class="bi bi-exclamation-triangle me-1"></i>Not serviceable yet</div>
        <div class="fdc-sub mb-0">We couldn't find a delivery charge for this pincode.</div>
      </div>`;
    return;
  }

  chargeEl.innerHTML = charge > 0 ? `₹${charge.toFixed(2)}` : '<span class="text-success">Free</span>';

  if (!info.free_delivery_allowed) {
    banner.innerHTML = `
      <div class="free-delivery-card flat-state">
        <div class="fdc-title"><i class="bi bi-truck me-1"></i>Delivery Charge: ₹${charge.toFixed(2)}</div>
        <div class="fdc-sub mb-0">A flat delivery charge applies to this area.</div>
      </div>`;
  } else if (info.free_unlocked) {
    banner.innerHTML = `
      <div class="free-delivery-card unlocked-state">
        <div class="fdc-title"><i class="bi bi-emoji-smile-fill me-1"></i>Free Delivery Unlocked 🎉</div>
        <div class="fdc-sub mb-0">No delivery charges on this order.</div>
      </div>`;
  } else {
    const remaining = Number(info.remaining);
    const threshold = Number(info.threshold);
    const pct = threshold > 0 ? Math.min(100, Math.round((cartTotal / threshold) * 100)) : 0;
    banner.innerHTML = `
      <div class="free-delivery-card progress-state">
        <div class="fdc-title"><i class="bi bi-truck me-1"></i>₹${remaining.toFixed(0)} away from FREE Delivery!</div>
        <div class="fdc-sub mb-0">Add more items to unlock free delivery (min. order ₹${threshold.toFixed(0)}).</div>
        <div class="fdc-progress-track"><div class="fdc-progress-fill" style="width:${pct}%"></div></div>
      </div>`;
  }
}

document.querySelectorAll('.address-radio').forEach(function(radio) {
  radio.addEventListener('change', function() {
    fetch(`<%= delivery_charge_customer_checkout_index_path %>?pincode=${encodeURIComponent(radio.dataset.pincode)}`, {
      headers: { 'Accept': 'application/json' }
    }).then(r => r.json()).then(renderDeliveryBanner).catch(() => {});
  });
});

// Auto-select default address if any
document.addEventListener('DOMContentLoaded', function() {
  const defaultAddress = document.querySelector('input[name="selected_address_id"][checked]');
  if (defaultAddress) {
    sessionStorage.setItem('selected_address_id', defaultAddress.value);
  }
});
</script>