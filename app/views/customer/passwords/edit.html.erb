<% content_for :title, 'Reset Password' %>

<% if flash[:reset_success] %>
  <!-- Success State -->
  <div class="welcome-text">
    <h1 class="welcome-title"><i class="bi bi-check-circle-fill text-success me-2"></i>Password Reset Done!</h1>
    <p class="welcome-subtitle">Your password has been updated successfully. You can now log in with your new password.</p>
  </div>

  <div class="d-grid gap-2 mb-4">
    <%= link_to "Go to Login", customer_login_path, class: "btn btn-primary btn-lg" %>
  </div>
<% else %>
  <!-- Reset Password Form -->
  <div class="welcome-text">
    <h1 class="welcome-title">Reset Your Password</h1>
    <p class="welcome-subtitle">Create a new secure password for your account</p>
  </div>

  <%= form_with url: customer_reset_password_path, method: :patch, local: true, id: "resetForm", class: "needs-validation", novalidate: true do |f| %>
    <%= f.hidden_field :token, value: @token %>

    <div class="form-group">
      <%= f.label :password, "New Password", class: "form-label" %>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
        <%= f.password_field :password,
                            class: "form-control",
                            placeholder: "Enter new password",
                            required: true,
                            minlength: 6,
                            id: "password" %>
      </div>
      <small class="text-muted"><i class="bi bi-info-circle"></i> Minimum 6 characters</small>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
        <%= f.password_field :password_confirmation,
                            class: "form-control",
                            placeholder: "Re-enter new password",
                            required: true,
                            id: "password_confirmation" %>
      </div>
      <small id="matchError" class="text-danger" style="display: none;">
        <i class="bi bi-exclamation-circle"></i> Passwords do not match
      </small>
    </div>

    <div class="d-grid gap-2 mb-4">
      <%= f.submit "Set New Password", class: "btn btn-primary btn-lg", data: { disable_with: "Updating..." } %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= link_to customer_login_path do %>
      <i class="bi bi-arrow-left me-1"></i>Back to Sign In
    <% end %>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('resetForm');
      const password = document.getElementById('password');
      const passwordConfirmation = document.getElementById('password_confirmation');
      const matchError = document.getElementById('matchError');

      function checkMatch() {
        if (passwordConfirmation.value.length > 0 && password.value !== passwordConfirmation.value) {
          matchError.style.display = 'block';
          passwordConfirmation.classList.add('is-invalid');
        } else {
          matchError.style.display = 'none';
          passwordConfirmation.classList.remove('is-invalid');
        }
      }

      password.addEventListener('input', checkMatch);
      passwordConfirmation.addEventListener('input', checkMatch);

      form.addEventListener('submit', function(e) {
        if (password.value.length < 6) {
          e.preventDefault();
          password.focus();
          return false;
        }
        if (password.value !== passwordConfirmation.value) {
          e.preventDefault();
          matchError.style.display = 'block';
          passwordConfirmation.focus();
          return false;
        }
      });
    });
  </script>
<% end %>
